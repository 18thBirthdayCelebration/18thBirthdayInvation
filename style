:root {
  --bg: #000000;
  --bg-alt: #05070f;
  --text: #d6d9e8;
  --muted: #8a90aa;
  --white: #ffffff;
  --accent: #9fb0e6;               /* soft periwinkle blue */
  --tone: #aebbea;                 /* header logo / nav tone */
  --gold: #c9a961;                 /* muted champagne gold - used sparingly */
  --gold-soft: #e3cf9a;
  --gold-line: rgba(201, 169, 97, 0.45);
  --navy-deep: #03061c;
  --midnight: #070d38;
  --navy: #0b1650;
  --line: rgba(255, 255, 255, 0.28);
  --line-strong: rgba(255, 255, 255, 0.7);

  /* hero background photo (the JS at the bottom sets this if the file loads) */
  --hero-img: none;

  /* fluid spacing */
  --pad-x: clamp(20px, 7vw, 120px);
  --pad-y: clamp(72px, 11vw, 130px);
  --gap: clamp(40px, 7vw, 110px);
}

* { margin: 0; padding: 0; box-sizing: border-box; }

html {
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
}

body {
  font-family: 'Poppins', sans-serif;
  font-weight: 300;
  color: var(--text);
  background: var(--bg);
  line-height: 2;
  font-size: clamp(0.84rem, 0.8rem + 0.2vw, 0.95rem);
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

img { max-width: 100%; display: block; }

/* ---------- Shared ---------- */
.section {
  padding: var(--pad-y) var(--pad-x);
  position: relative;
}
.section.alt { background: var(--bg-alt); }

.wrap {
  width: 100%;
  max-width: 1180px;
  margin: 0 auto;
}

.eyebrow {
  font-weight: 300;
  font-size: 0.66rem;
  letter-spacing: 0.5em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 18px;
}

.heading {
  font-weight: 200;
  font-size: clamp(1.4rem, 1rem + 2vw, 2.3rem);
  letter-spacing: 0.4em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 26px;
  line-height: 1.4;
  overflow-wrap: anywhere;
}
/* small gold hairline under each section heading */
.heading::after {
  content: "";
  display: block;
  width: 46px;
  height: 1px;
  margin: 20px 0 0;
  background: linear-gradient(90deg, var(--gold), transparent);
}
.center .heading::after,
.rsvp .heading::after {
  margin: 20px auto 0;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
}

.copy { max-width: 470px; }
.copy p { margin-bottom: 18px; }

.split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--gap);
  align-items: center;
}

/* ---------- Buttons (thin outline, oval, arrow) ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 26px;
  max-width: 100%;
  padding: 14px 34px;
  border: 1px solid var(--line-strong);
  border-radius: 999px;
  color: var(--white);
  background: transparent;
  text-decoration: none;
  font-family: 'Poppins', sans-serif;
  font-weight: 300;
  font-size: 0.64rem;
  line-height: 1.4;
  letter-spacing: 0.38em;
  text-transform: uppercase;
  transition: background 0.35s ease, color 0.35s ease, border-color 0.35s ease;
  margin-top: 14px;
  -webkit-tap-highlight-color: transparent;
}
.btn svg { width: 22px; height: 10px; flex: none; transition: transform 0.35s ease; }
.btn:active { background: var(--gold); color: #000; border-color: var(--gold); }
.btn:focus-visible, .fab:focus-visible { outline: 1px solid var(--gold); outline-offset: 4px; }

/* ---------- Photo shots ---------- */
.shot {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #10143a, #03040c);
}
.shot img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.shot.empty::after {
  content: attr(data-label);
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8px;
  text-align: center;
  color: var(--muted);
  font-size: 0.58rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
}
.tag {
  position: absolute;
  left: 8%;
  bottom: 9%;
  z-index: 2;
  color: var(--white);
  font-size: 0.58rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  line-height: 1.6;
  padding-bottom: 6px;
  border-bottom: 1px solid var(--line-strong);
  text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
}

/* =====================================================
   1. INTRODUCTION  (black header + navy nav bar + hero with face photo)
   ===================================================== */
.topbar {
  background: #000;
  padding: 20px var(--pad-x);
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 20px;
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-size: 0.78rem;
  letter-spacing: 0.06em;
  color: #b9c0dc;
  border-bottom: 1px solid rgba(201, 169, 97, 0.18);
}
.topbar a, .topbar span.item {
  color: inherit;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 10px;
}
.topbar svg.ico { width: 14px; height: 14px; color: var(--tone); flex: none; }
.topbar .left { justify-self: start; }
.topbar .right { justify-self: end; text-align: right; }

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-decoration: none;
  line-height: 1;
}
.brand svg { width: 58px; height: 52px; color: var(--gold); margin-bottom: 8px; }
.brand b {
  font-family: 'Playfair Display', serif;
  font-style: normal;
  font-weight: 400;
  font-size: clamp(1.1rem, 0.8rem + 1.2vw, 1.6rem);
  letter-spacing: 0.36em;
  padding-left: 0.36em;
  text-transform: uppercase;
  color: var(--tone);
}

.hero {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: max(620px, calc(100svh - 128px));
  background:
    radial-gradient(ellipse at 22% 55%, rgba(70, 95, 220, 0.38), transparent 60%),
    radial-gradient(ellipse at 0% 100%, rgba(201, 169, 97, 0.10), transparent 45%),
    linear-gradient(135deg, #0c1658 0%, #070d38 55%, #03061c 100%);
  overflow: hidden;
}

/* semi-transparent navy nav bar sitting on top of the hero */
.navbar {
  position: absolute;
  top: 0; left: 0; right: 0;
  z-index: 4;
  display: flex;
  align-items: stretch;
  height: 46px;
  padding: 0 var(--pad-x);
  background: rgba(10, 16, 62, 0.82);
  border-bottom: 1px solid var(--gold-line);
  -webkit-backdrop-filter: blur(4px);
  backdrop-filter: blur(4px);
  overflow-x: auto;
  scrollbar-width: none;
}
.navbar::-webkit-scrollbar { display: none; }
.navbar a {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 0 clamp(14px, 2.2vw, 28px);
  font-family: 'Playfair Display', serif;
  font-size: 0.72rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #c3cbea;
  text-decoration: none;
  white-space: nowrap;
  border-left: 1px solid rgba(255, 255, 255, 0.12);
  transition: color 0.3s ease, background 0.3s ease;
}
.navbar a:first-child { padding-left: 0; border-left: 0; color: var(--gold-soft); }
.navbar a svg { width: 7px; height: 9px; }
.navbar a:active { color: #fff; }

/* ----- HERO BACKGROUND: blue-rose frame image ----- */
.hero-photo {
  position: absolute;
  inset: 0;
  z-index: 0;
  background-image: none !important;     /* layers below draw the image */
  opacity: 0;                             /* fades in once the image has loaded */
  transition: opacity 1.4s ease;
  overflow: hidden;
}
.hero-photo.loaded { opacity: 1; }

/* blurred copy fills the sides on wide screens */
.hero-photo::before {
  content: "";
  position: absolute;
  inset: -40px;
  background: var(--hero-img) center / cover no-repeat;
  filter: blur(26px) brightness(0.55);
}
/* the sharp frame image, whole and centered, with a soft darkening behind the text */
.hero-photo::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse at center, rgba(3, 6, 28, 0.45) 0%, transparent 65%),
    var(--hero-img) center / auto 100% no-repeat;
  pointer-events: none;
}

.hero-copy {
  position: relative;
  z-index: 2;
  width: min(70vw, 290px);
  margin: 0 auto;
  padding: 90px 0 60px;
  text-align: center;
  color: #eef0fb;
  text-shadow: 0 2px 18px rgba(3, 6, 28, 0.7);
}
.hero-copy .pre {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-size: clamp(0.95rem, 0.85rem + 0.4vw, 1.15rem);
  letter-spacing: 0.04em;
  margin-bottom: 4px;
  color: var(--gold-soft);
}
.hero-copy h1 {
  font-family: 'Playfair Display', serif;
  font-weight: 400;
  font-size: clamp(1.3rem, 0.9rem + 1.6vw, 1.9rem);
  letter-spacing: 0.08em;
  padding-left: 0.08em;
  text-transform: uppercase;
  line-height: 1.3;
  color: #ffffff;
}
.hero-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  margin: 26px auto 22px;
  width: min(100%, 260px);
}
.hero-divider::before, .hero-divider::after {
  content: "";
  flex: 1;
  height: 1px;
  background: var(--gold-line);
}
.hero-divider svg { width: 26px; height: 24px; color: var(--gold); flex: none; }

.hero-copy .who {
  font-family: 'Playfair Display', serif;
  font-size: 0.82rem;
  letter-spacing: 0.4em;
  padding-left: 0.4em;
  text-transform: uppercase;
  margin-bottom: 8px;
  color: #ffffff;
}
.hero-copy .when {
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-size: 1rem;
  color: #c3cbea;
  line-height: 1.7;
  margin-bottom: 24px;
}

.btn-hero {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 22px;
  padding: 13px 38px;
  border: 1px solid var(--gold);
  border-radius: 999px;
  color: #ffffff;
  background: rgba(7, 13, 56, 0.35);
  text-decoration: none;
  font-family: 'Poppins', sans-serif;
  font-weight: 400;
  font-size: 0.64rem;
  letter-spacing: 0.34em;
  text-transform: uppercase;
  text-shadow: none;
  transition: background 0.35s ease, color 0.35s ease, border-color 0.35s ease;
  -webkit-tap-highlight-color: transparent;
}
.btn-hero svg { width: 20px; height: 9px; flex: none; transition: transform 0.35s ease; }
.btn-hero:active { background: var(--gold); color: #070d38; border-color: var(--gold); }
.btn-hero:focus-visible { outline: 1px solid var(--gold); outline-offset: 4px; }

/* ---------- 2. Welcome letter ---------- */
.collage {
  position: relative;
  width: 100%;
  max-width: 560px;
  aspect-ratio: 1 / 1;
  justify-self: center;
}
.collage .s1 { position: absolute; left: 0; top: 0; width: 62%; aspect-ratio: 4 / 5; z-index: 1; }
.collage .s3 { position: absolute; right: 0; top: 0; width: 34%; aspect-ratio: 3 / 4; z-index: 1; }
.collage .s2 { position: absolute; right: 0; bottom: 0; width: 52%; aspect-ratio: 1 / 1; z-index: 2; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7); }
.collage .s2 .tag { left: 10%; bottom: 12%; }

.signoff { margin-top: 26px; color: var(--white); letter-spacing: 0.1em; }
.signoff span {
  display: block;
  margin-top: 4px;
  color: var(--gold);
  font-family: 'Playfair Display', serif;
  font-style: italic;
  font-size: 1.15rem;
  letter-spacing: 0.12em;
  text-transform: none;
}

/* ---------- 3. What to wear ---------- */
.center { text-align: center; }
.center .wrap { display: flex; flex-direction: column; align-items: center; }
.center .copy { max-width: 540px; }

.swatches { display: flex; gap: 16px; margin: 6px 0 clamp(44px, 7vw, 70px); }
.swatches span {
  width: 30px; height: 30px;
  border-radius: 50%;
  border: 1px solid var(--line-strong);
}

.attire-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--gap);
  width: 100%;
  max-width: 1000px;
}
.attire-col h3 {
  font-weight: 200;
  font-size: 1.15rem;
  letter-spacing: 0.4em;
  padding-left: 0.4em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 24px;
}
.pair { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(10px, 2vw, 16px); }
.pair .shot { aspect-ratio: 3 / 4; }
.attire-col .note { margin-top: 20px; color: var(--muted); font-size: 0.78rem; letter-spacing: 0.08em; }

/* ---------- 4. Location ---------- */
.venue {
  font-weight: 300;
  font-size: 1.05rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--white);
  margin-bottom: 4px;
  overflow-wrap: anywhere;
}
.address { color: var(--muted); margin-bottom: 18px; }

.map-frame {
  width: 100%;
  aspect-ratio: 4 / 3;
  border: 1px solid var(--gold-line);
  padding: 10px;
  background: #04060f;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7);
}
.map-frame iframe {
  width: 100%;
  height: 100%;
  border: 0;
  display: block;
  filter: invert(92%) hue-rotate(180deg) grayscale(0.4) brightness(0.85);
}

/* ---------- 5. RSVP ---------- */
.rsvp { text-align: center; }
.rsvp .wrap { display: flex; flex-direction: column; align-items: center; }
.rsvp .big {
  font-weight: 200;
  font-size: clamp(2.4rem, 1rem + 7vw, 5rem);
  letter-spacing: 0.5em;
  padding-left: 0.5em;
  color: var(--accent);
  line-height: 1.2;
  margin-bottom: 18px;
}
.rsvp .big::after {
  content: "";
  display: block;
  width: 46px;
  height: 1px;
  margin: 18px auto 0;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
}
.rsvp .lead { max-width: 420px; margin: 0 auto 20px; }
.rsvp footer {
  margin-top: clamp(56px, 9vw, 90px);
  font-size: 0.64rem;
  letter-spacing: 0.45em;
  line-height: 2;
  text-transform: uppercase;
  color: var(--muted);
  padding-bottom: 60px; /* room so the floating button never covers it */
}

/* ---------- Floating RSVP ---------- */
.fab {
  position: fixed;
  right: max(18px, env(safe-area-inset-right));
  bottom: max(18px, env(safe-area-inset-bottom));
  z-index: 100;
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 12px 24px;
  border: 1px solid var(--gold-line);
  border-radius: 999px;
  background: rgba(7, 13, 56, 0.88);
  -webkit-backdrop-filter: blur(6px);
  backdrop-filter: blur(6px);
  color: var(--white);
  text-decoration: none;
  font-size: 0.6rem;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  transition: background 0.35s ease, color 0.35s ease, border-color 0.35s ease;
  -webkit-tap-highlight-color: transparent;
}
.fab svg { width: 16px; height: 16px; flex: none; color: var(--gold); transition: color 0.35s ease; }
.fab:active { background: var(--gold); color: #000; border-color: var(--gold); }
.fab:active svg { color: #000; }

/* ---------- Scroll reveal ---------- */
.reveal { opacity: 0; transform: translateY(26px); transition: opacity 1.1s ease, transform 1.1s ease; }
.reveal.visible { opacity: 1; transform: translateY(0); }

/* ---------- Hover only on devices that really hover ---------- */
@media (hover: hover) {
  .btn:hover, .fab:hover { background: var(--gold); color: #000; border-color: var(--gold); }
  .fab:hover svg { color: #000; }
  .btn:hover svg, .btn-hero:hover svg { transform: translateX(5px); }
  .btn-hero:hover { background: var(--gold); color: var(--midnight); border-color: var(--gold); }
  .navbar a:hover { color: var(--gold-soft); background: rgba(255, 255, 255, 0.06); }
}

/* ---------- Large desktop ---------- */
@media (min-width: 1500px) {
  body { font-size: 1rem; }
  .wrap { max-width: 1280px; }
}

/* ---------- Tablet ---------- */
@media (max-width: 1024px) {
  .heading { letter-spacing: 0.34em; }
}

/* ---------- Mobile + small tablet ---------- */
@media (max-width: 800px) {
  /* header: only the centered logo */
  .topbar { grid-template-columns: 1fr; padding: 16px var(--pad-x); }
  .topbar .left, .topbar .right { display: none; }

  /* hero: frame image fills the screen on phones */
  .hero { min-height: 640px; }
  .hero-photo::after {
    background:
      radial-gradient(ellipse at center, rgba(3, 6, 28, 0.45) 0%, transparent 65%),
      var(--hero-img) center / cover no-repeat;
  }
  .hero-copy { padding: 96px 0 60px; }

  .split { grid-template-columns: 1fr; gap: 56px; }
  .split .copy { margin: 0 auto; text-align: center; }
  .split .heading::after { margin: 20px auto 0; background: linear-gradient(90deg, transparent, var(--gold), transparent); }
  .collage { max-width: 480px; }

  .attire-grid { grid-template-columns: 1fr; gap: 56px; max-width: 480px; }
  .map-frame { max-width: 560px; margin: 0 auto; }

  .heading { letter-spacing: 0.3em; padding-left: 0.3em; }

  /* floating button shrinks to a round icon */
  .fab { padding: 14px; gap: 0; }
  .fab span { display: none; }
}

/* ---------- Small phones ---------- */
@media (max-width: 420px) {
  .eyebrow { letter-spacing: 0.38em; }
  .hero-copy h1 { letter-spacing: 0.06em; padding-left: 0.06em; }
  .hero-copy .who { letter-spacing: 0.3em; padding-left: 0.3em; }
  .btn { gap: 18px; padding: 13px 24px; letter-spacing: 0.28em; }
  .btn-hero { padding: 13px 30px; letter-spacing: 0.28em; }
  .tag { font-size: 0.52rem; letter-spacing: 0.22em; }
  .rsvp footer { letter-spacing: 0.3em; }
  .venue { letter-spacing: 0.2em; }
}

/* ---------- Very small phones (320px) ---------- */
@media (max-width: 340px) {
  .heading { letter-spacing: 0.2em; padding-left: 0.2em; }
  .rsvp .big { letter-spacing: 0.3em; padding-left: 0.3em; }
  .brand b { letter-spacing: 0.24em; padding-left: 0.24em; }
}

/* ---------- Short landscape phones ---------- */
@media (max-height: 520px) and (orientation: landscape) {
  .hero-copy { padding-top: 84px; padding-bottom: 40px; }
}

/* ---------- Respect reduced-motion setting ---------- */
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .reveal { opacity: 1; transform: none; transition: none; }
  .hero-photo { transition: none; }
}